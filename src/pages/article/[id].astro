---
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import { url } from '../../lib/url.js';
import { isoDate } from '../../lib/date.js';
import { countText } from '../../lib/text.js';
import '../../styles/prose.css';

export async function getStaticPaths() {
  const posts = await getCollection('posts', ({ data }) => !data.draft);
  return posts.map((post) => ({ params: { id: post.id }, props: { post } }));
}

const { post } = Astro.props;
const { Content, headings } = await render(post);

const stats = countText(post.body);
const dateLabel = isoDate(post.data.date);

// keep the outline to h2/h3 and drop anything without a slug
const toc = headings.filter((h) => (h.depth === 2 || h.depth === 3) && h.slug);

const meta = [
  { label: 'Date', value: dateLabel },
  { label: 'Read time', value: `${stats.minutes} min` },
  { label: 'Words', value: stats.words.toLocaleString('en-US') },
];
---

<Base title={post.data.title} description={post.data.summary ?? post.data.title} wide>
  <a class="back-link" href={url('article/')}>↩ Article</a>

  <div class="post-layout">
    <aside class="post-sidebar">
      <div class="progress-wrap">
        <svg class="progress-ring" width="28" height="28" viewBox="0 0 28 28" aria-hidden="true">
          <circle class="progress-ring__bg" cx="14" cy="14" r="12"></circle>
          <circle class="progress-ring__bar" id="progressBar" cx="14" cy="14" r="12"></circle>
        </svg>
        <span class="progress-label" id="progressLabel">0%</span>
      </div>

      <div class="section-title toc-title">On this page</div>
      <ul class="toc" id="toc">
        {
          toc.map((heading) => (
            <li class={`toc__item toc__item--h${heading.depth}`}>
              <a class="toc__link" href={`#${heading.slug}`} data-target={heading.slug}>
                {heading.text}
              </a>
            </li>
          ))
        }
      </ul>
    </aside>

    <article class="post-main">
      <h1 class="post-title">{post.data.title}</h1>

      <div class="post-meta">
        <div class="post-meta__row">
          {
            meta.map((item) => (
              <div class="post-meta__item">
                <span class="post-meta__label">{item.label}</span>
                <span class="post-meta__value">{item.value}</span>
              </div>
            ))
          }
          {
            post.data.categories.length > 0 && (
              <div class="post-meta__item">
                <span class="post-meta__label">Category</span>
                <span class="post-meta__value">
                  {post.data.categories.map((c) => (
                    <span class="badge badge--category">{c}</span>
                  ))}
                </span>
              </div>
            )
          }
        </div>

        {
          post.data.tags.length > 0 && (
            <div class="post-meta__row">
              <div class="post-meta__item post-meta__item--inline">
                <span class="post-meta__label">Tags</span>
                <span class="tag-list">
                  {post.data.tags.map((t) => (
                    <span class="badge badge--tag">{t}</span>
                  ))}
                </span>
              </div>
            </div>
          )
        }
      </div>

      <div class="prose" id="articleBody">
        <Content />
      </div>
    </article>
  </div>
</Base>

<style>
  .back-link {
    display: inline-block;
    font-size: var(--fs-sm);
    color: var(--text-dim);
    margin-bottom: var(--sp-6);
    transition: color var(--transition);
  }

  .back-link:hover {
    color: var(--accent-soft);
  }

  .post-layout {
    display: flex;
    gap: var(--gap-sidebar);
    padding-bottom: var(--sp-20);
  }

  /* ---------- sidebar ---------- */
  /* The outline is often taller than the viewport on long notes. Sticking the
     whole sidebar pins it to the top of the page, which leaves the lower
     entries permanently off-screen until the reader reaches the very bottom of
     the article. Instead the sidebar sticks, and the list scrolls inside it,
     so every entry stays reachable regardless of article length. */
  .post-sidebar {
    width: var(--w-sidebar);
    flex-shrink: 0;
    position: sticky;
    top: var(--sp-10);
    align-self: flex-start;
    display: flex;
    flex-direction: column;
    /* never taller than the space between the top offset and the viewport edge */
    max-height: calc(100dvh - var(--sp-10) - var(--sp-6));
    min-height: 0;
  }
  .progress-wrap {
    display: flex;
    align-items: center;
    gap: var(--sp-2);
    margin-bottom: var(--sp-8);
    padding-left: var(--sp-2);
  }

  .progress-ring {
    flex-shrink: 0;
    transform: rotate(-90deg);
  }

  .progress-ring__bg {
    fill: transparent;
    stroke: var(--border);
    stroke-width: 3;
  }

  .progress-ring__bar {
    fill: transparent;
    stroke: var(--accent);
    stroke-width: 3;
    stroke-linecap: round;
    stroke-dasharray: 75.4;
    stroke-dashoffset: 75.4;
    transition: stroke-dashoffset 0.1s linear;
  }

  .progress-label {
    font-size: var(--fs-xs);
    color: var(--text-dim);
    font-variant-numeric: tabular-nums;
  }

  .toc-title {
    font-size: var(--fs-sm);
    margin-bottom: var(--sp-4);
    padding-left: var(--sp-2);
  }

  .toc-title::before {
    width: 12px;
    height: 12px;
  }

  .toc {
    list-style: none;
    padding: 0;
    margin: 0;
    border-left: 1px solid var(--border);
    /* the list, not the sidebar, takes the overflow */
    overflow-y: auto;
    overscroll-behavior: contain;
    min-height: 0;
    /* room for the active item's tick marks so they are not clipped */
    padding-right: var(--sp-2);
  }

  /* the same slim scrollbar treatment as the rest of the site */
  .toc::-webkit-scrollbar {
    width: 6px;
  }

  .toc::-webkit-scrollbar-thumb {
    border: none;
    border-radius: var(--radius-pill);
  }

  .toc__item {
    position: relative;
    padding-left: var(--sp-4);
    margin-bottom: var(--sp-3);
    font-size: var(--fs-sm);
    line-height: 1.45;
  }  /* signature: the short horizontal tick off the rule */
  .toc__item::before {
    content: '';
    position: absolute;
    left: 0;
    top: 50%;
    width: 10px;
    height: 1px;
    background-color: var(--border);
    transition: background-color var(--transition), width var(--transition);
  }

  .toc__item--h3 {
    padding-left: var(--sp-6);
  }

  .toc__item--h3::before {
    width: 18px;
  }

  .toc__link {
    color: var(--text-dim);
    transition: color var(--transition);
    display: block;
  }

  .toc__link:hover {
    color: var(--text-muted);
  }

  .toc__item:has(.toc__link.active)::before {
    background-color: var(--accent);
  }

  .toc__link.active {
    color: var(--text-hi);
    font-weight: 700;
  }

  /* ---------- article head ---------- */
  .post-main {
    flex: 1 1 auto;
    min-width: 0;
    max-width: var(--w-prose);
  }  .post-title {
    font-size: var(--fs-2xl);
    font-weight: 700;
    color: var(--text-hi);
    line-height: 1.3;
    letter-spacing: 0;
    margin: 0 0 var(--sp-6) 0;
  }

  .post-title::after {
    content: '.';
    color: var(--accent);
  }

  .post-meta {
    display: flex;
    flex-direction: column;
    gap: var(--sp-4);
    border-bottom: 1px solid var(--border);
    padding-bottom: var(--sp-5);
    margin-bottom: var(--sp-10);
  }

  .post-meta__row {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--sp-10);
  }

  .post-meta__item {
    display: flex;
    flex-direction: column;
    gap: var(--sp-1);
  }

  .post-meta__item--inline {
    flex-direction: row;
    align-items: center;
    gap: var(--sp-4);
  }

  .post-meta__label {
    font-size: var(--fs-xs);
    color: var(--text-faint);
  }

  .post-meta__value {
    font-size: var(--fs-sm);
    color: var(--text-muted);
    font-variant-numeric: tabular-nums;
    display: flex;
    gap: var(--sp-2);
    flex-wrap: wrap;
  }

  @media (max-width: 860px) {
    .post-layout {
      flex-direction: column;
    }

    /* On phones the outline is more noise than help: it pushes the article
       title below the fold and its entries read as a wall of wrapped text.
       Drop the TOC entirely and keep only the progress readout, which answers
       "how far in am I" without claiming a block of its own. */
    .toc-title,
    .toc {
      display: none;
    }

    .post-sidebar {
      width: 100%;
      position: static;
      border-bottom: none;
      padding-bottom: 0;
      margin-bottom: var(--sp-5);
    }

    .progress-wrap {
      margin-bottom: 0;
    }

    .toc__item {
      padding-left: 0;
      margin-bottom: 0;
    }

    .toc__item::before {
      display: none;
    }

    .toc__item--h3 {
      padding-left: 0;
    }

    .post-meta__row {
      gap: var(--sp-5);
    }
  }
</style>

<script>
  // ---- reading progress + TOC highlight ----
  const bar = document.getElementById('progressBar');
  const label = document.getElementById('progressLabel');
  const links = Array.from(document.querySelectorAll('.toc__link'));
  const body = document.getElementById('articleBody');

  if (bar && label) {
    const r = Number(bar.getAttribute('r'));
    const circumference = 2 * Math.PI * r;
    bar.style.strokeDasharray = String(circumference);

    let ticking = false;

    const update = () => {
      const scrollTop = window.scrollY;
      const docHeight = document.documentElement.scrollHeight - window.innerHeight;
      const pct = docHeight > 0 ? Math.min(1, Math.max(0, scrollTop / docHeight)) : 0;

      bar.style.strokeDashoffset = String(circumference * (1 - pct));
      label.textContent = `${Math.round(pct * 100)}%`;

      if (links.length > 0) {
        let current = links[0].dataset.target;
        for (const link of links) {
          const target = document.getElementById(link.dataset.target);
          if (target && target.getBoundingClientRect().top <= 140) {
            current = link.dataset.target;
          }
        }
        for (const link of links) {
          const isCurrent = link.dataset.target === current;
          link.classList.toggle('active', isCurrent);
        }

        // Keep the highlighted entry inside the outline's own scroll box, so
        // the reader can always see where they are in a long article.
        const activeLink = links.find((l) => l.dataset.target === current);
        const list = activeLink?.closest('.toc');
        if (activeLink && list && list.scrollHeight > list.clientHeight) {
          const linkBox = activeLink.getBoundingClientRect();
          const listBox = list.getBoundingClientRect();
          const margin = 24;

          if (linkBox.top < listBox.top + margin) {
            list.scrollTop += linkBox.top - listBox.top - margin;
          } else if (linkBox.bottom > listBox.bottom - margin) {
            list.scrollTop += linkBox.bottom - listBox.bottom + margin;
          }
        }
      }

      ticking = false;
    };

    const onScroll = () => {
      if (!ticking) {
        ticking = true;
        window.requestAnimationFrame(update);
      }
    };

    window.addEventListener('scroll', onScroll, { passive: true });
    window.addEventListener('resize', onScroll, { passive: true });
    update();
  }

  // ---- code blocks: language label + copy button ----
  // Each <pre> is wrapped in a positioned div so the controls stay pinned
  // while the code itself scrolls horizontally.
  for (const pre of document.querySelectorAll('.prose pre')) {
    const code = pre.querySelector('code');
    if (!code) continue;

    const wrap = document.createElement('div');
    wrap.className = 'code-block';
    pre.parentNode.insertBefore(wrap, pre);
    wrap.appendChild(pre);

    // Shiki 7 puts the language on the <pre data-language>; older versions
    // used a `language-*` class on <code>. Support both.
    const langName =
      pre.dataset.language ||
      Array.from(code.classList)
        .find((c) => c.startsWith('language-'))
        ?.slice('language-'.length);

    if (langName && langName !== 'plaintext') {
      const lang = document.createElement('span');
      lang.className = 'code-lang';
      lang.textContent = langName;
      wrap.appendChild(lang);
    }

    const btn = document.createElement('button');
    btn.type = 'button';
    btn.className = 'code-copy';
    btn.textContent = 'copy';
    btn.setAttribute('aria-label', 'Copy code');
    btn.addEventListener('click', async () => {
      try {
        await navigator.clipboard.writeText(code.innerText);
        btn.textContent = 'copied';
        btn.dataset.copied = 'true';
        setTimeout(() => {
          btn.textContent = 'copy';
          btn.dataset.copied = 'false';
        }, 1600);
      } catch {
        btn.textContent = 'failed';
        setTimeout(() => {
          btn.textContent = 'copy';
        }, 1600);
      }
    });
    wrap.appendChild(btn);
  }

  // guard: nothing above should run if the article body is missing
  void body;
</script>
