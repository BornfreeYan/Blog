---
import Base from '../layouts/Base.astro';
import SectionHeader from '../components/SectionHeader.astro';
import ListRow from '../components/ListRow.astro';
import { getPosts, postHref } from '../lib/posts.js';
import { isoDate } from '../lib/date.js';
import { url } from '../lib/url.js';
import { site } from '../data/site.js';
import projects from '../data/projects.json';

const posts = await getPosts();
const latestPosts = posts.slice(0, site.homeArticleCount);
const latestProjects = projects.slice(0, site.homeProjectCount);
---

<Base>
  <section class="bio">
    <div class="bio__text">
      <p set:html={site.bio} />
    </div>
    <div class="social-links">
      {
        site.links.map((link, i) => (
          <>
            {i > 0 && <span class="social-sep" aria-hidden="true">·</span>}
            <a
              class="social-link"
              href={link.href}
              target={link.href.startsWith('http') ? '_blank' : undefined}
              rel={link.href.startsWith('http') ? 'noopener' : undefined}
            >
              {link.label}
            </a>
          </>
        ))
      }
      <span class="social-sep" aria-hidden="true">·</span>
      <button
        type="button"
        class="copy-email"
        id="copyEmail"
        data-email={site.email}
        aria-label={`Copy email address ${site.email}`}
      >
        Email<span class="copy-email__done" hidden>√</span>
      </button>
    </div>
  </section>

  <section class="section">
    <SectionHeader title="Article" allHref={url('article/')} />
    <div class="list">
      {
        latestPosts.map((post) => (
          <ListRow
            href={url(postHref(post))}
            title={post.data.title}
            meta={isoDate(post.data.date)}
          />
        ))
      }
      {latestPosts.length === 0 && <p class="empty">No articles yet.</p>}
    </div>
  </section>

  <section class="section">
    <SectionHeader title="Project" allHref={url('project/')} />
    <div class="list">
      {
        latestProjects.map((project) => (
          <ListRow
            href={project.href}
            title={project.name}
            meta={project.tags?.[0] ?? ''}
          />
        ))
      }
    </div>
  </section>
</Base>

<script>
  // One-click copy for the email: no mailto, no navigation, no clipboard UI.
  const btn = document.getElementById('copyEmail');
  const done = btn?.querySelector('.copy-email__done');

  btn?.addEventListener('click', async () => {
    const email = btn.dataset.email;
    if (!email) return;

    try {
      await navigator.clipboard.writeText(email);
    } catch {
      // clipboard API needs a secure context; fall back to a temp textarea
      const ta = document.createElement('textarea');
      ta.value = email;
      ta.setAttribute('readonly', '');
      ta.style.position = 'fixed';
      ta.style.opacity = '0';
      document.body.appendChild(ta);
      ta.select();
      document.execCommand('copy');
      ta.remove();
    }

    if (!done) return;
    done.hidden = false;
    btn.dataset.copied = 'true';
    setTimeout(() => {
      done.hidden = true;
      btn.dataset.copied = 'false';
    }, 1600);
  });
</script>
