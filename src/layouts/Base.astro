---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { url } from '../lib/url.js';
import { absoluteImage, canonicalUrl } from '../lib/meta.js';
import '../styles/global.css';

const {
  title = "Yan's Blog",
  description = 'Notes, projects, and technical retrospectives.',
  wide = false,
  image = null,
  imageAlt = null,
  type = 'website',
  publishedTime = null,
} = Astro.props;

const pageTitle = title === "Yan's Blog" ? title : `${title} — Yan's Blog`;
const rssHref = url('rss.xml');

const canonical = canonicalUrl(Astro.url.pathname, Astro.site);
// Every page gets a preview image: its own, or the site-wide default.
const ogImage = absoluteImage(image || 'og-default.jpg', Astro.site);
const ogImageAlt = imageAlt || title;
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    {canonical && <link rel="canonical" href={canonical} />}
    <meta name="color-scheme" content="dark" />
    <meta name="theme-color" content="#121212" />
    <link rel="icon" href={url('favicon.svg')} type="image/svg+xml" />
    <link rel="sitemap" href={url('sitemap-index.xml')} />
    <link rel="alternate" type="application/rss+xml" title="Yan's Blog" href={rssHref} />

    <meta property="og:type" content={type} />
    <meta property="og:site_name" content="Yan's Blog" />
    <meta property="og:locale" content="zh_CN" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    {canonical && <meta property="og:url" content={canonical} />}
    {publishedTime && <meta property="article:published_time" content={publishedTime} />}
    {ogImage && <meta property="og:image" content={ogImage} />}
    {ogImage && <meta property="og:image:alt" content={ogImageAlt} />}

    <meta name="twitter:card" content={ogImage ? 'summary_large_image' : 'summary'} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    {ogImage && <meta name="twitter:image" content={ogImage} />}
    {ogImage && <meta name="twitter:image:alt" content={ogImageAlt} />}
  </head>
  <body>
    <div class:list={['frame', wide && 'frame--wide']}>
      <Header />
      <main class="site-main">
        <slot />
      </main>
      <Footer />
    </div>
  </body>
</html>
